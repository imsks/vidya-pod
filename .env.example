# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/vidya-pod

# Cashfree (server-only, used in API routes)
CASHFREE_CLIENT_ID=your-client-id
CASHFREE_SECRET_KEY=your-secret-key
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# Cashfree checkout mode (client-side SDK): "sandbox" or "production"
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# App URL (for payment return URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
