# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key — same value local CLI prints as "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Supabase OAuth Configuration
# Configure Google OAuth in your Supabase Dashboard:
# 1. Go to Authentication > Providers > Google
# 2. Enable Google Provider
# 3. Add your Google OAuth Client ID and Client Secret
# 4. Set the Redirect URL to: https://your-project.supabase.co/auth/v1/callback
# 5. Add the redirect URL to your Google OAuth app's authorized redirect URIs

# Cashfree (server-only, used in API routes)
CASHFREE_CLIENT_ID=your-client-id
CASHFREE_SECRET_KEY=your-secret-key
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# App URL (for payment return URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
