# Supabase (Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only — Supabase Dashboard → Settings → API Keys → Secret key (sb_secret_..., never NEXT_PUBLIC_*)
SUPABASE_SECRET_KEY=your-secret-key

# PostgreSQL (required for Docker Compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vidyapod

# Database (Prisma)
# Docker Compose — use db as host:
DATABASE_URL=postgresql://postgres:postgres@db:5432/vidyapod?schema=public
# Host dev (.env.local) — use localhost instead of db:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidyapod?schema=public

# Cashfree (server-only, used in API routes)
CASHFREE_CLIENT_ID=your-client-id
CASHFREE_SECRET_KEY=your-secret-key
CASHFREE_BASE_URL=https://sandbox.cashfree.com
CASHFREE_WEBHOOK_SECRET=your-webhook-secret

# App URL (for payment return URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Secret PIN (temporary authentication for admin-only endpoints)
# TODO: Remove once RBAC is implemented
ADMIN_SECRET=your-admin-secret-pin
