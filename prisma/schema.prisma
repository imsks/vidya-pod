// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE ENTITY MODELS
// ============================================

/// Sponsors - Individuals or organizations sponsoring learners
model Sponsor {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String
  phone        String
  organization String?
  imageUrl     String?        @map("image_url")
  showPublicly Boolean        @default(false) @map("show_publicly")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  learners     Learner[]
  orders       SponsorOrder[]

  @@map("sponsors")
}

/// Learners - Students/learners using the platform
model Learner {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  phone             String?
  standard          String
  imageUrl          String?        @map("image_url")
  sponsorId         String?        @map("sponsor_id") @db.Uuid
  /// End of the paid sponsorship period. Null means the sponsorship never lapses.
  sponsorshipEndsAt DateTime?      @map("sponsorship_ends_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  sponsor           Sponsor?       @relation(fields: [sponsorId], references: [id])
  orders            SponsorOrder[]

  @@index([sponsorId])
  @@index([sponsorId, sponsorshipEndsAt])
  @@map("learners")
}

/// Teachers - Instructors teaching learners
model Teacher {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  phone         String
  qualification String
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("teachers")
}

/// Proctors - Proctors overseeing learner activities
model Proctor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  phone         String
  qualification String
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("proctors")
}

/// Sponsor order status enum
enum SponsorOrderStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

/// Sponsor plan type enum
enum SponsorPlanType {
  monthly
  yearly
}

enum ExpenseCategory {
  TEACHER_FEE
  STUDENT_FEES
  STATIONERY
  PROCTOR_FEE
  OTHER
}

/// SponsorOrders - Orders/records of sponsorship transactions
model SponsorOrder {
  id                         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                    String             @unique @map("order_id")
  /// Cashfree order id. One payment can cover several learners, one row each.
  paymentOrderId             String             @map("payment_order_id")
  name                       String
  email                      String
  phone                      String
  plan                       SponsorPlanType
  amount                     Int
  status                     SponsorOrderStatus @default(PENDING)
  paymentSessionId           String?            @map("payment_session_id")
  publicAcknowledgementOptIn Boolean            @default(false) @map("public_acknowledgement_opt_in")
  shareSlug                  String?            @unique @map("share_slug")
  sponsorId                  String?            @map("sponsor_id") @db.Uuid
  learnerId                  String?            @map("learner_id") @db.Uuid
  createdAt                  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  sponsor                    Sponsor?           @relation(fields: [sponsorId], references: [id])
  learner                    Learner?           @relation(fields: [learnerId], references: [id])

  @@index([sponsorId])
  @@index([learnerId])
  @@index([status])
  @@index([paymentOrderId])
  @@map("sponsor_orders")
}

model Expense {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    ExpenseCategory
  amount      Int
  description String
  incurredAt  DateTime        @default(now()) @map("incurred_at") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([incurredAt])
  @@map("expenses")
}
